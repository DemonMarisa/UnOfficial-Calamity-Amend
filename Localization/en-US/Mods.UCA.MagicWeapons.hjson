CarnageRay: {
	DisplayName: Carnage Ray
	Tooltip:
		'''
		Damage increases the farther the ray travels (75% - 150%)
		Fires homing blood orbs around the ray.
		Right Click: Stabs forward, consuming mana to launch homing blood orbs.
		Weapon Skill: Blood Great Sword
		[KEY]: Consumes [LAPManaCost] mana and [LAPFocusCost] focus point to slash forward, releasing numerous homing blood orbs.
		'''
}

TerraRay: {
	DisplayName: Terra Ray
	Tooltip:
		'''
		Fires a beam of ancient tree essence that splits into ancient branches towards nearby enemies.  
		Spawns homing natural spears when the beam disappears.  
		Right Click: Swings the staff, summoning natural spears and floral tornadoes around you and at the cursor.
		Tornadoes fire healing projectiles towards the player and split into more spears upon hitting enemies.  
		Weapon Skill: Fusang Blessing  
		Has 3 uses, recovering one use every 45 seconds.  
		[KEY]: Consumes [LAPManaCost] mana and [LAPFocusCost] focus point Reduces movement speed and grants 75% defense damage reduction. Summons tornadoes at your position and up to 4 nearby enemies after charging.  
		[KEY] + Up: If uses remain, restores 30% max health after charging and grants a 30-second buff:
		+10 HP/s life regen, 10% defense damage reduction, 15% damage reduction, +30 defense.
		"In the name of the sol,may we walk the path of Tao"
		'''
}

PlasmaRodAlt: {
	DisplayName: Plasma Rod
	Tooltip:
		'''
		Fires a plasma beam that splits into 8 homing beams on impact.
		Right Click: Launches an exploding shadow fireball.
		Weapon Skill : Magic Sword
		[KEY]: Consumes [LAPFocusCost] focus point to slash forward.
		'''
}

NightsRayAlt: {
	DisplayName: Nights Ray
	Tooltip:
		'''
		Damage increases the closer the ray is to the enemy (200% - 75%)
		Fires dark beams that split and attack nearby enemies.
		Right Click: Expands a shield that consumes mana, deflects projectiles, and absorbs up to 400 damage.
		Provides damage reduction and defense. (Effectiveness decreases when mana is zero)
		Weapon Skill : Nights Blessing
		[KEY]: Consumes [LAPFocusCost] focus point. Grants a 30-second comprehensive attack and defense buff, and fully restores the shield.
		'''
}

ElementRayAlt: {
	DisplayName: Elemental Ray
	Tooltip:
		'''
		Fires a pure elemental beam.
		Right Click to use the special ability base on current mode.
		Different modes grant different attack styles and special abilities.
		Pressing [KEY] to switch attack mode
		[UCAElementRayReplaceKey]
		'''
}

ElementRayMisc:
	'''
	[ItemIconKey][c/E2E4F4:Combined Mode]
	Triggers a Solar explosion and blasts Nebula energy on enemy hit.  
	Leaves Stardust fragments to attack enemies when the beam disappears.  
	Launches Vortex Missiles from behind to track enemies.  
	[ItemIconKey][c/E2E4F4:Weapon Skill: Resplendent Life]
	Consumes [LAPManaCost] mana to Raises staff; after a short delay, restores 5% max health and grants 15 HP/s regeneration for 10 seconds.
	'''
ElementRaySolor:
	'''
	[ItemIconKey][c/FFA500:Solar Mode]
	Triggers a larger Flare explosion on enemy hit
	Simultaneously launches a large number of Flare fireballs
	[ItemIconKey][c/FFA500:Weapon Skill: Solar Greatsword]
	Consumes [LAPManaCost] mana to charge. Release Right Click to slash forward. 100 times damage
	Damage will decrease based on the number of enemies hit, with a minimum of 10 times damage
	Grants +30 defense and 15% defense damage reduction for a short time upon hitting an enemy.
	'''
ElementRayVortex:
	'''
	[ItemIconKey][c/66CDAA:Vortex Mode]
	Launches Vortex Missiles from behind to track enemies
	Fires lightning at the nearest enemy when the beam disappears
	[ItemIconKey][c/66CDAA:Weapon Skill: Lighting Storm]
	Consumes [LAPManaCost] mana to charge. Randomly launches numerous Vortex Missiles around you after chargings
	Grants 1.1x damage for a short period after use
	'''
ElementRayNebula:
	'''
	[ItemIconKey][c/FF00FF:Nebula Mode]
	Explodes with more Nebula energy on enemy hit
	Emits Nebula energy from around you to track enemies
	[ItemIconKey][c/FF00FF:Weapon Skill: Nebula Crystal Rain]
	Consumes [LAPManaCost] mana to charge. Launches numerous cosmic crystals forward after a short delay
	Hitting an enemy with a crystal grants you a Nebula Boost buff and Spawn healing Projectile
	'''
ElementRayStarDust:
	'''
	[ItemIconKey][c/FF00FF:Stardust Mode]
	Explodes with more Stardust Laser on enemy hit
	Leaves Stardust fragments to attack enemies when the beam disappears
	[ItemIconKey][c/4169E1:Weapon skill: Soul Stream]
	Consumes [LAPManaCost] mana to charge. Launches a powerful Soul Stream forward after a short delay
	Halves your mana consumption for a short period after use
	'''

ShadowBoltStaffAlt: {
	DisplayName: Shadow Bolt Staff
	Tooltip:
		'''
		Fires a pure Shadow Bolt
		The more enemies travels through the more damage the beam does (15%)
		Right click: Consumes [ManaCost] mana teleport all shadows to your side
		Weapon Skill: Shadow of the SoulPress
		the [KEY] key Consumes [LAPFocusCost] focus point to summon eight shadows around the player after a brief charge.
		the player can dodge one attack within the next 30 seconds.
		The dodge grants 180 frames of invincibility.
		The skill has a 30 second cooldown.
		'''
}

SoulPiercerAlt: {
	DisplayName: Soul Piercer
	Tooltip:
		'''
		Casts a Cosmic ray that summons extra rays and spawn orbs that heal you
		Right click: Swings the staff, summoning Cosmic Slash at the cursor and inflict 20s Marked for Death debuffs
		Weapon Skill: Soul Greatsword
		Consumes [LAPManaCost] mana to slash forward.
		During charging and slashing, grant 50% damage reduction
		Hitting an enemy will grant you 40 immunity frames 
		'''
}

VividClarityAlt: {
	DisplayName: Vivid Clarity
	Tooltip:
		'''
			Left-click to attack with the staff, right-click to use the current mode's special ability
			Hold [KEY] to open the mode wheel and switch attack modes
			[UCAVividClarityReplaceKey]
			[c/F0FFFF:Its majesty inspires feats of unparalleled genius]
			
		'''
}

VividClarityAttack:
	'''
	[c/98FB98:Current Mode: Assault]
	Fires 9 astral beams in quick succession towards the cursor
	Each beam triggers an explosion and calls down astral lightning from the sky
	[c/98FB98:Current Skill: Blade of White Light]
	Consumes [LAPManaCost] mana to charge, then hold left-click to unleash a forward slash dealing 100x base damage
	Damage decreases per enemy hit, down to a minimum of 10x base damage
	Hold left-click to chain up to 3 consecutive slashes
	'''
VividClarityDefense:
	'''
	[c/98FB98:Current Mode: Defense]
	Left-click fires a powerful beam that splits into additional lasers to attack enemies
	Direct hits trigger an explosion and astral lightning
	While left-clicking, press right-click to consume [LAPFocusCost] focus and perform a parry
	Parry window: 8 frames, recovery: 22 frames
	[c/98FB98:Current Skill: Astral Requital]
	Consumes [LAPFocusCost] focus to perform a parry
	Parry window: 30 frames, recovery: 15 frames
	A successful parry restores 10% of max life, triggers an explosion, and resets this skill's cooldown
	'''
VividClaritySupport:
	'''
	[c/98FB98:Current Mode: Support]
	Left-click continuously fires 5 astral beams
	The beams randomly cause explosions, lightning, or additional projectiles
	[c/66CDAA:Current Skill: Dawn Cleaver]
	Consumes [LAPFocusCost] Focus to summon an autonomous Vivid Clarity Blade, lasting 2 minutes.
	While the blade is active, left-click toggles Healing Mode.
	When toggled, the blade stops attacking and follows you, healing you.
	Press left-click again to deactivate Healing Mode.
	Press right-click while the blade is active to dismiss it.
	The blade prioritizes the nearest enemy.
	It alternates between firing projectiles at enemies and dashing through them.
	'''
