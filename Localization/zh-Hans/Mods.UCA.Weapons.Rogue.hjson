BlazingHammer: {
	DisplayName: 炽热锚锤
	Tooltip:
		'''
		投掷强大的炽热之锤，命中时造成爆炸
		潜伏攻击状态下，锤子返程时会回击敌人并完全锁定在敌人身上
		挂载后，锤子以超高频率持续攻击，每次命中均触发爆炸
		潜伏攻击造成伤害时会向上喷发火球
		挂载状态时按下右键，将会使锤子高速冲向指针位置后回击挂载单位
		锤子消亡时将自动释放巨型火柱 
		'''
}

DivineHammer: {
	DisplayName: 双联神锤
	Tooltip:
		'''
		投掷强大的星系之锤，命中敌人时释放普通的星云射线
		潜伏攻击时，掷出一个超高速的神明之锤，在返程至玩家身上时回击敌人
		撞击敌人后分裂成两个子锤，子锤在一定时间后发起挂载
		子锤挂载期间，从玩家身后召唤多个追踪的光之矢冲向你的敌人
		挂载结束后，子锤将会返程至玩家手中并再进行一次回击
		'''
}

NightmareHammer: {
	DisplayName: 冥魇陨星
	Tooltip:
		'''
		投掷强大的梦魇之锤，命中时梦魇之星从天而降
		潜伏攻击时，梦魇之锤将在返程后冲向敌人，并在一定时间后挂载在敌人上
		冲向敌人的过程中，暗能量球会持续释放，待延迟后锁定敌人发起攻击
		挂载状态下，降下的梦魇之星的伤害与数量将随造成伤害的次数逐步提升
		[c/BA55D3:"于噩梦中冥思，召陨星归位，引梦魇噬敌"]
		'''
	ShimmerTooltip: "这把武器好像与某处的荧光之湖产生了共鸣……"
}

PunishmentHammer: {
	DisplayName: 裁罚圣锤
	Tooltip:
		'''
		投掷一把裁决之锤，命中时迸发神圣新星
		潜伏攻击时，裁决之锤将在返程后回击，并挂载在敌人上造成持续伤害
		挂载过程中会以一定的频率释放延迟追踪的裁决之星
		存在任意挂载圣锤时，潜伏攻击返程后将会转化为多个追踪的神圣新星
		挂载结束后，裁决之锤释放十字裁罚射线
		所有攻击都会造成圣火减益
		'''
}

ThunderHammer: {
	DisplayName: Thunder Hammer
	Tooltip: ""
}

Hammer_General:
	'''
	准许潜伏且消耗减半，+10 最大潜伏值，无法获得潜伏增伤
	切换武器/护甲时潜伏条被重置
	'''
